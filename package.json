{
  "name": "lagooner-beach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "description": "Lagooner Beach \u2014 close a loop of blocks; it fills with water and pops.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p . && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run ideas:check",
    "tune": "tsx scripts/tune.ts",
    "ideas": "tsx scripts/render-ideas.ts",
    "ideas:check": "tsx scripts/render-ideas.ts && git diff --exit-code docs/IDEAS.md",
    "puzzles": "tsx scripts/gen-puzzles.ts --count 360",
    "coverage": "vitest run --coverage",
    "size": "tsx scripts/size-check.ts",
    "art:lint": "ART_LINT_WRITE=1 vitest run tests/unit/art-lint.test.ts && prettier --write docs/art/LINT.md"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/ios": "7.6.9"
  }
}
